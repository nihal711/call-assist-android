<?xml version="1.0" encoding="utf-8"?>
<!--
  Unselected Recents tab.

  The handset and the arrow pair read as one overlapping glyph: the handset
  is ~84% of the glyph's total width and spans its full height, with the
  arrows sitting over its upper-right shoulder. An earlier
  version tucked a small handset into the bottom-left corner with the arrows
  floating separately in the top-right, which read as two disconnected marks.

  The handset is the standard phone path — already drawn on the diagonal, so no
  rotation is involved — scaled to 16.6 of the 24-unit viewport and anchored
  bottom-left. The transform is baked into the path coordinates rather than
  applied via <group> so the geometry stays inspectable and is byte-identical
  to ic_recents_filled. Only the handset changes between the two files (stroked
  here, filled there), so selecting the tab shifts nothing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Handset, hollow. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M4.53,11.97c1.33,2.61 3.47,4.74 6.09,6.09l2.03,-2.03c0.25,-0.25 0.62,-0.33 0.94,-0.22c1.04,0.34 2.15,0.53 3.29,0.53c0.51,0.00 0.92,0.41 0.92,0.92l0.00,3.22c0.00,0.51 -0.41,0.92 -0.92,0.92c-8.66,0.00 -15.68,-7.02 -15.68,-15.68c0.00,-0.51 0.41,-0.92 0.92,-0.92l3.23,0.00c0.51,0.00 0.92,0.41 0.92,0.92c0.00,1.15 0.18,2.25 0.53,3.29c0.11,0.33 0.02,0.68 -0.23,0.94l-2.04,2.02z" />

    <!-- Incoming arrow: down-left, over the handset's shoulder. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.55"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M14.40,4.64L9.34,9.70M9.34,7.37L9.34,9.70L11.67,9.70" />

    <!-- Outgoing arrow: up-right. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.55"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M14.52,11.68L19.90,6.62M17.43,6.62L19.90,6.62L19.90,9.09" />
</vector>
