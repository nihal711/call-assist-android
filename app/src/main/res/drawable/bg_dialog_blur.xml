<?xml version="1.0" encoding="utf-8"?>
<!-- Used only when real cross-window blur is active: the fill is much more
     transparent so the blurred content behind actually shows through. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/glassBlurFill" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glassStroke" />
</shape>
