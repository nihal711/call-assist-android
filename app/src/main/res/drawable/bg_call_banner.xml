<?xml version="1.0" encoding="utf-8"?>
<!-- Return-to-call banner: same glass surface as the nav bar. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/trackBg">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/navBg" />
            <stroke android:width="1dp" android:color="@color/glassStroke" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</ripple>
