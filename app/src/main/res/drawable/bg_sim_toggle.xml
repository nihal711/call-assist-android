<?xml version="1.0" encoding="utf-8"?>
<!-- Segment of the SIM switcher in the call confirmation dialog; the chosen
     segment is marked with View#setSelected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accentSoft" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rowPressed" />
            <stroke android:width="1dp" android:color="@color/glassStroke" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card2" />
            <stroke android:width="1dp" android:color="@color/glassStroke" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
