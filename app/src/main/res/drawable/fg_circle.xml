<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground for circular buttons on a neutral (card2) fill: press ripple
     clipped to the circle, plus a 2dp accent ring while keyboard/switch focused. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/trackBg">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="@color/accent" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
