<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/row_pad_h"
    android:paddingTop="@dimen/row_pad_v"
    android:paddingEnd="@dimen/row_pad_h"
    android:paddingBottom="@dimen/row_pad_v">

    <FrameLayout
        android:layout_width="@dimen/avatar"
        android:layout_height="@dimen/avatar"
        android:importantForAccessibility="noHideDescendants">

        <TextView
            android:id="@+id/avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_circle"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Glyph instead of an initial (blocked numbers) -->
        <ImageView
            android:id="@+id/avatarIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/card2"
            android:contentDescription="@null"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            app:tint="@color/textSecondary" />

        <!-- Shown instead of the initial when the contact has a photo -->
        <ImageView
            android:id="@+id/avatarPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/Text.Secondary"
            android:fontFeatureSettings="tnum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/meta"
        style="@style/Text.Secondary"
        android:fontFeatureSettings="tnum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp" />
</LinearLayout>
