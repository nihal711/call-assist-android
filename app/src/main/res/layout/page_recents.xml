<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recentsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Large title with inline actions; collapses to a compact bar on scroll. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <!-- Selection mode: "All" toggle at the start -->
        <LinearLayout
            android:id="@+id/btnSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/select_all"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/selectAllIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_circle"
                app:tint="@color/textSecondary" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:text="@string/all"
                android:textColor="@color/textPrimary" />
        </LinearLayout>

        <TextView
            android:id="@+id/recentsTitle"
            style="@style/Text.PageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="24dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:text="@string/recents" />

        <ImageButton
            android:id="@+id/btnRecentsSearch"
            style="@style/HeaderAction"
            android:contentDescription="@string/search_calls"
            android:src="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/btnRecentsFilter"
            style="@style/HeaderAction"
            android:contentDescription="@string/filter_calls"
            android:src="@drawable/ic_filter" />

        <ImageButton
            android:id="@+id/btnRecentsMore"
            style="@style/HeaderAction"
            android:contentDescription="@string/more_options"
            android:src="@drawable/ic_more_vert" />

        <TextView
            android:id="@+id/btnSelectCancel"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/cancel"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/recentsSearchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/recentsSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/bg_search"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="12dp"
            android:drawableTint="@color/textSecondary"
            android:hint="@string/search_calls"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="52dp"
            android:paddingBottom="12dp"
            android:singleLine="true"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textSecondary"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnRecentsSearchClose"
            style="@style/HeaderAction"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/close_search"
            android:src="@drawable/ic_close" />
    </FrameLayout>

    <!-- Active filters: call type (dismissable) + call time (single choice) -->
    <HorizontalScrollView
        android:id="@+id/recentsChipsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipType"
                style="@style/AppChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:visibility="gone"
                app:closeIconEnabled="true"
                app:closeIconTint="@color/accentText" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSim"
                style="@style/AppChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:checkable="false"
                android:visibility="gone"
                app:closeIconEnabled="true"
                app:closeIconTint="@color/accentText" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipTimeGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:saveEnabled="false"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="false"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipToday"
                    style="@style/AppChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:saveEnabled="false"
                    android:text="@string/today" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip7"
                    style="@style/AppChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:saveEnabled="false"
                    android:text="@string/past_7_days" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip30"
                    style="@style/AppChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:saveEnabled="false"
                    android:text="@string/past_30_days" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Wide screens: list on the left, detail card on the right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recentsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="@dimen/nav_content_clearance"
                android:scrollbars="none" />

            <!-- Empty / loading / no-permission state, centred in the list area -->
            <LinearLayout
                android:id="@+id/recentsEmptyBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/nav_content_clearance"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/recentsEmpty"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/no_calls_yet"
                    android:textColor="@color/textSecondary" />

                <TextView
                    android:id="@+id/recentsEmptyAction"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_sim_chip"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/allow"
                    android:textColor="@color/accentText"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/recentsLoading"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:indeterminateTint="@color/accent"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/recentsDetail"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:paddingStart="4dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="@dimen/nav_content_clearance"
            android:visibility="gone">

            <TextView
                android:id="@+id/recentsDetailEmpty"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/select_a_call"
                android:textColor="@color/textSecondary" />

            <FrameLayout
                android:id="@+id/recentsDetailCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
