<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed incoming-call notification: Decline / Answer stay visible without
     expanding (Samsung's shade hides CallStyle's buttons in the collapsed row). The
     expanded view and the heads-up banner remain the system's CallStyle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    tools:ignore="UseAppTint">

    <ImageView
        android:id="@+id/notifPhoto"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_notif_btn"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notifName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/textPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notifStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/notifDecline"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_notif_btn_red"
        android:contentDescription="@string/decline"
        android:padding="10dp"
        android:rotation="135"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_phone"
        android:tint="#FFFFFF" />

    <ImageButton
        android:id="@+id/notifAnswer"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_notif_btn_green"
        android:contentDescription="@string/answer"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_phone"
        android:tint="#FFFFFF" />
</LinearLayout>
