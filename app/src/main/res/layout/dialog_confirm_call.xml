<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="32dp"
    android:paddingEnd="28dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="@dimen/circle_primary"
        android:layout_height="@dimen/circle_primary"
        android:layout_gravity="center_horizontal"
        android:importantForAccessibility="noHideDescendants">

        <TextView
            android:id="@+id/dlgAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_circle"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Shown instead of the initial when the contact has a photo -->
        <ImageView
            android:id="@+id/dlgPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/dlgName"
        style="@style/Text.CardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2" />

    <TextView
        android:id="@+id/dlgNumber"
        style="@style/Text.Body"
        android:fontFeatureSettings="tnum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/textSecondary" />

    <!-- Dual-SIM only: segmented switcher; the pick applies to this call. -->
    <LinearLayout
        android:id="@+id/dlgSimRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone" />

    <!-- Dual-SIM only: pins the picked SIM to this number for future calls -->
    <CheckBox
        android:id="@+id/dlgSimRemember"
        style="@style/Text.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:minHeight="48dp"
        android:buttonTint="@color/accent"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dlgCancel"
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_cancel"
            android:gravity="center"
            android:text="@string/cancel" />

        <LinearLayout
            android:id="@+id/dlgCall"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_call"
            android:contentDescription="@string/call"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_phone"
                app:tint="#FFFFFF" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:text="@string/call"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
