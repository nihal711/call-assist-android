<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/bgPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Second call (held, or waiting behind the ringing one) -->
        <LinearLayout
            android:id="@+id/otherCallCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_call_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/otherAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/otherName"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/otherState"
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMerge"
                android:layout_width="@dimen/circle_secondary"
                android:layout_height="@dimen/circle_secondary"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/card2"
                android:contentDescription="@string/merge_calls"
                android:foreground="@drawable/fg_circle"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_merge"
                android:visibility="gone"
                app:tint="@color/textPrimary" />

            <ImageButton
                android:id="@+id/btnSwap"
                android:layout_width="@dimen/circle_secondary"
                android:layout_height="@dimen/circle_secondary"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/accent"
                android:contentDescription="@string/swap_calls"
                android:foreground="@drawable/fg_circle_on_color"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_swap"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Identity block first: name, state, SIM, timer -->
        <TextView
            android:id="@+id/callerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:shadowColor="#80000000"
            android:shadowRadius="8"
            android:textColor="@color/textPrimary"
            android:textSize="32sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="32sp"
            app:autoSizeMinTextSize="22sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/callState"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:shadowColor="#80000000"
            android:shadowRadius="8"
            android:textColor="@color/textSecondary" />

        <!-- Dual-SIM only: which SIM this call is on -->
        <LinearLayout
            android:id="@+id/simChip"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/chip_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_sim_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/simChipBadge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/simChipName"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:textColor="@color/textPrimary" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/callTimer"
            android:fontFeatureSettings="tnum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:textColor="@color/greenText"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Unknown number: one tap to save it -->
        <LinearLayout
            android:id="@+id/btnAddContact"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/chip_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_sim_chip"
            android:contentDescription="@string/add_to_contacts"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_person_add"
                app:tint="@color/accentText" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:text="@string/add_to_contacts"
                android:textColor="@color/accentText" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/avatarFrame"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:importantForAccessibility="noHideDescendants">

            <TextView
                android:id="@+id/avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="46sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/avatarPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- DTMF keypad, toggled from the Keypad tile -->
        <LinearLayout
            android:id="@+id/keypadPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/dtmfDisplay"
                android:fontFeatureSettings="tnum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:ellipsize="start"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/textPrimary"
                android:textSize="26sp" />

            <GridLayout
                android:id="@+id/keypad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3" />
        </LinearLayout>

        <!-- Unlocked: round decline / answer -->
        <LinearLayout
            android:id="@+id/ringingButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnEndAnswer"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_sim_chip"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/end_current_answer"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnMessageLocked"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_sim_chip"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/send_message" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnDecline"
                        android:layout_width="@dimen/circle_primary"
                        android:layout_height="@dimen/circle_primary"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/red"
                        android:contentDescription="@string/decline"
                        android:foreground="@drawable/fg_circle_on_color"
                        android:padding="18dp"
                        android:rotation="135"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_phone"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/labelDecline"
                        style="@style/Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:importantForAccessibility="no"
                        android:text="@string/decline" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnAnswer"
                        android:layout_width="@dimen/circle_primary"
                        android:layout_height="@dimen/circle_primary"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/green"
                        android:contentDescription="@string/answer"
                        android:foreground="@drawable/fg_circle_on_color"
                        android:padding="18dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_phone"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/labelAnswer"
                        style="@style/Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:importantForAccessibility="no"
                        android:text="@string/answer" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Locked: decline circle beside slide to answer (volume silences) -->
        <LinearLayout
            android:id="@+id/ringingSlide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="36dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnMessageSlide"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_sim_chip"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/send_message" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnDeclineSlide"
                    android:layout_width="@dimen/circle_action"
                    android:layout_height="@dimen/circle_action"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/red"
                    android:contentDescription="@string/decline"
                    android:foreground="@drawable/fg_circle_on_color"
                    android:padding="14dp"
                    android:rotation="135"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_phone"
                    app:tint="#FFFFFF" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1">

                    <SeekBar
                        android:id="@+id/slideAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:max="100"
                        android:maxHeight="64dp"
                        android:minHeight="64dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_slide_track"
                        android:splitTrack="false"
                        android:thumb="@drawable/slider_thumb"
                        android:thumbOffset="0dp" />

                    <TextView
                        android:id="@+id/slideHint"
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:clickable="false"
                        android:importantForAccessibility="no"
                        android:text="@string/slide_to_answer"
                        android:textColor="@color/textSecondary" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- In call: 2×3 action tiles + end -->
        <LinearLayout
            android:id="@+id/activeBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnMute"
                        android:layout_width="@dimen/circle_action"
                        android:layout_height="@dimen/circle_action"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/card2"
                        android:contentDescription="@string/mute"
                        android:foreground="@drawable/fg_circle"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/textPrimary" />

                    <TextView
                        android:id="@+id/labelMute"
                        style="@style/Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:importantForAccessibility="no"
                        android:text="@string/mute" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnKeypad"
                        android:layout_width="@dimen/circle_action"
                        android:layout_height="@dimen/circle_action"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/card2"
                        android:contentDescription="@string/keypad"
                        android:foreground="@drawable/fg_circle"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_dialpad"
                        app:tint="@color/textPrimary" />

                    <TextView
                        android:id="@+id/labelKeypad"
                        style="@style/Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:importantForAccessibility="no"
                        android:text="@string/keypad" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnSpeaker"
                        android:layout_width="@dimen/circle_action"
                        android:layout_height="@dimen/circle_action"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/card2"
                        android:contentDescription="@string/speaker"
                        android:foreground="@drawable/fg_circle"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_speaker"
                        app:tint="@color/textPrimary" />

                    <TextView
                        android:id="@+id/labelSpeaker"
                        style="@style/Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:importantForAccessibility="no"
                        android:text="@string/speaker" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnAddCall"
                        android:layout_width="@dimen/circle_action"
                        android:layout_height="@dimen/circle_action"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/card2"
                        android:contentDescription="@string/add_call"
                        android:foreground="@drawable/fg_circle"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_add_call"
                        app:tint="@color/textPrimary" />

                    <TextView
                        android:id="@+id/labelAddCall"
                        style="@style/Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:importantForAccessibility="no"
                        android:text="@string/add_call" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnHold"
                        android:layout_width="@dimen/circle_action"
                        android:layout_height="@dimen/circle_action"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/card2"
                        android:contentDescription="@string/hold"
                        android:foreground="@drawable/fg_circle"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_pause"
                        app:tint="@color/textPrimary" />

                    <TextView
                        android:id="@+id/labelHold"
                        style="@style/Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:importantForAccessibility="no"
                        android:text="@string/hold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnContact"
                        android:layout_width="@dimen/circle_action"
                        android:layout_height="@dimen/circle_action"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/card2"
                        android:contentDescription="@string/contact"
                        android:foreground="@drawable/fg_circle"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_person"
                        app:tint="@color/textPrimary" />

                    <TextView
                        android:id="@+id/labelContact"
                        style="@style/Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:importantForAccessibility="no"
                        android:text="@string/contact" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnHangup"
                android:layout_width="@dimen/circle_primary"
                android:layout_height="@dimen/circle_primary"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/red"
                android:contentDescription="@string/end_call"
                android:foreground="@drawable/fg_circle_on_color"
                android:padding="18dp"
                android:rotation="135"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_phone"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
