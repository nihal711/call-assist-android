<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/bgPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Second call (held, or waiting behind the ringing one) -->
        <LinearLayout
            android:id="@+id/otherCallCard"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_call_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/otherAvatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/otherName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/otherState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMerge"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/card2"
                android:contentDescription="Merge calls"
                android:scaleType="center"
                android:src="@drawable/ic_merge"
                android:visibility="gone"
                app:tint="@color/textPrimary" />

            <ImageButton
                android:id="@+id/btnSwap"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/accent"
                android:contentDescription="Swap calls"
                android:scaleType="center"
                android:src="@drawable/ic_swap"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/avatarFrame"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp">

            <TextView
                android:id="@+id/avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="46sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/avatarPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/callerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#80000000"
            android:shadowRadius="8"
            android:textColor="@color/textPrimary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/callState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:shadowColor="#80000000"
            android:shadowRadius="8"
            android:textColor="@color/textSecondary"
            android:textSize="16sp" />

        <!-- Dual-SIM only: which SIM this call is on -->
        <LinearLayout
            android:id="@+id/simChip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_sim_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingEnd="11dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/simChipBadge"
                android:layout_width="16dp"
                android:layout_height="16dp" />

            <TextView
                android:id="@+id/simChipName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:textColor="@color/textPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/callTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:textColor="@color/green"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Unknown number: one tap to save it -->
        <LinearLayout
            android:id="@+id/btnAddContact"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_sim_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_person_add"
                app:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Add to contacts"
                android:textColor="@color/accent"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- DTMF keypad, toggled from the Keypad tile -->
        <LinearLayout
            android:id="@+id/keypadPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/dtmfDisplay"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:ellipsize="start"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/textPrimary"
                android:textSize="26sp" />

            <GridLayout
                android:id="@+id/keypad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3" />
        </LinearLayout>

        <!-- Unlocked: round decline / answer -->
        <LinearLayout
            android:id="@+id/ringingButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnEndAnswer"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_sim_chip"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="End current &amp; answer"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnMessageLocked"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="26dp"
                android:background="@drawable/bg_sim_chip"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Send message"
                android:textColor="@color/textPrimary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnDecline"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/red"
                        android:contentDescription="Decline"
                        android:padding="19dp"
                        android:rotation="135"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_phone"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Decline"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnAnswer"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/green"
                        android:contentDescription="Answer"
                        android:padding="19dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_phone"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Answer"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Locked: slide to answer (power button declines, volume silences) -->
        <LinearLayout
            android:id="@+id/ringingSlide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="36dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnMessageSlide"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_sim_chip"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Send message"
                android:textColor="@color/textPrimary"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="64dp">

                <SeekBar
                    android:id="@+id/slideAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:max="100"
                    android:maxHeight="64dp"
                    android:minHeight="64dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_slide_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/slider_thumb"
                    android:thumbOffset="0dp" />

                <TextView
                    android:id="@+id/slideHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:clickable="false"
                    android:text="slide to answer"
                    android:textColor="@color/textSecondary"
                    android:textSize="15sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- In call: 2×3 action tiles + end -->
        <LinearLayout
            android:id="@+id/activeBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnMute"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/card2"
                    android:contentDescription="Mute"
                    android:scaleType="center"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/textPrimary" />

                <TextView
                    android:id="@+id/labelMute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Mute"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnKeypad"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/card2"
                    android:contentDescription="Keypad"
                    android:scaleType="center"
                    android:src="@drawable/ic_dialpad"
                    app:tint="@color/textPrimary" />

                <TextView
                    android:id="@+id/labelKeypad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Keypad"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnSpeaker"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/card2"
                    android:contentDescription="Speaker"
                    android:scaleType="center"
                    android:src="@drawable/ic_speaker"
                    app:tint="@color/textPrimary" />

                <TextView
                    android:id="@+id/labelSpeaker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Speaker"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnAddCall"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/card2"
                    android:contentDescription="Add call"
                    android:scaleType="center"
                    android:src="@drawable/ic_add_call"
                    app:tint="@color/textPrimary" />

                <TextView
                    android:id="@+id/labelAddCall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Add call"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnHold"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/card2"
                    android:contentDescription="Hold"
                    android:scaleType="center"
                    android:src="@drawable/ic_pause"
                    app:tint="@color/textPrimary" />

                <TextView
                    android:id="@+id/labelHold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Hold"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnContact"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/card2"
                    android:contentDescription="Contact"
                    android:scaleType="center"
                    android:src="@drawable/ic_person"
                    app:tint="@color/textPrimary" />

                <TextView
                    android:id="@+id/labelContact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Contact"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnHangup"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/red"
                android:contentDescription="End call"
                android:padding="18dp"
                android:rotation="135"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_phone"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
