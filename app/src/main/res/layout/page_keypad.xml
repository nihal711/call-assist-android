<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="81dp">

        <LinearLayout
            android:id="@+id/suggestionsEmptyBox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/suggestionsEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textSecondary"
                android:textSize="15sp" />

            <!-- Typed number with no match: offer to save or text it -->
            <LinearLayout
                android:id="@+id/keypadActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/btnAddToContacts"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_sim_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_person_add"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Add to contacts"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSendMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_sim_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_message"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Send message"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Empty keypad + text on the clipboard -->
            <LinearLayout
                android:id="@+id/btnPaste"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_sim_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Paste number"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/suggestionsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="40dp"
            android:scrollbars="none"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/keypadPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="56dp"
                android:paddingEnd="12dp">

                <!-- EditText so the user can place the cursor mid-number (e.g. to
                     prepend an IDD prefix or drop a '+'); the keypad feeds it
                     directly and the soft keyboard is suppressed in code -->
                <EditText
                    android:id="@+id/numberDisplay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:minHeight="60dp"
                    android:textSize="34sp" />

                <ImageButton
                    android:id="@+id/btnBackspace"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Backspace"
                    android:src="@drawable/ic_backspace"
                    android:visibility="invisible"
                    app:tint="@color/textSecondary" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/keypadGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="22dp">

                <!-- Dual-SIM only: which SIM the dial button will use. Tap to change. -->
                <LinearLayout
                    android:id="@+id/simChip"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_sim_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="9dp"
                    android:paddingEnd="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/simChipBadge"
                        android:layout_width="18dp"
                        android:layout_height="18dp" />

                    <ImageView
                        android:id="@+id/simChipIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_sim"
                        android:visibility="gone"
                        app:tint="@color/textSecondary" />

                    <TextView
                        android:id="@+id/simChipName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="104dp"
                        android:textColor="@color/textPrimary"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="2dp"
                        android:contentDescription="@null"
                        android:rotation="90"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/textSecondary" />
                </LinearLayout>

                <!--
                  fitCenter + padding rather than scaleType="center": "center"
                  would pin the vector at its intrinsic 24dp and leave the
                  handset marooned in the circle. 15dp of padding scales it
                  up to ~36dp, a chunkier glyph-to-circle ratio.
                -->
                <ImageButton
                    android:id="@+id/btnDial"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/green"
                    android:contentDescription="Call"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_phone"
                    app:tint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/fabKeypad"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="93dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/green"
        android:contentDescription="Show keypad"
        android:elevation="8dp"
        android:scaleType="center"
        android:src="@drawable/ic_dialpad"
        android:visibility="gone"
        app:tint="#FFFFFF" />
</FrameLayout>
