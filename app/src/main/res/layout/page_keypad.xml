<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="@dimen/nav_content_clearance">

        <LinearLayout
            android:id="@+id/suggestionsEmptyBox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/suggestionsEmpty"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp" />

            <!-- Typed number with no match: offer to save or text it -->
            <LinearLayout
                android:id="@+id/keypadActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/btnAddToContacts"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:background="@drawable/bg_sim_chip"
                    android:contentDescription="@string/add_to_contacts"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_person_add"
                        app:tint="@color/accentText" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:text="@string/add_to_contacts" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSendMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_sim_chip"
                    android:contentDescription="@string/send_message"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_message"
                        app:tint="@color/accentText" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:text="@string/send_message" />
                </LinearLayout>
            </LinearLayout>

            <!-- Empty keypad + text on the clipboard -->
            <LinearLayout
                android:id="@+id/btnPaste"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/bg_sim_chip"
                android:contentDescription="@string/paste_number"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="20dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/accentText" />

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:text="@string/paste_number" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/suggestionsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="40dp"
            android:scrollbars="none"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/keypadPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <!-- EditText so the user can place the cursor mid-number; the keypad
                     feeds it directly and the soft keyboard is suppressed in code.
                     Auto-sizes 40 → 22sp so a 15-digit international number stays
                     whole instead of scrolling the leading "+" out of view. -->
                <EditText
                    android:id="@+id/numberDisplay"
                    android:fontFeatureSettings="tnum"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:minHeight="64dp"
                    android:textColor="@color/textPrimary"
                    android:textSize="40sp"
                    app:autoSizeMaxTextSize="40sp"
                    app:autoSizeMinTextSize="22sp"
                    app:autoSizeStepGranularity="2sp"
                    app:autoSizeTextType="uniform"
                    tools:ignore="LabelFor" />

            </LinearLayout>

            <GridLayout
                android:id="@+id/keypadGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="4dp">

                <!-- 72dp primary circle, 36dp glyph (50%). -->
                <ImageButton
                    android:id="@+id/btnDial"
                    android:layout_width="@dimen/circle_primary"
                    android:layout_height="@dimen/circle_primary"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/green"
                    android:contentDescription="@string/call"
                    android:foreground="@drawable/fg_circle_on_color"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_phone"
                    app:tint="#FFFFFF" />

                <!-- Centred under the # key: 12dp grid padding + 2.5 cells of (w-24)/3. -->
                <ImageButton
                    android:id="@+id/btnBackspace"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/backspace"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_backspace"
                    android:visibility="invisible"
                    app:tint="@color/textSecondary" />
            </FrameLayout>

            <!-- Dual-SIM only. A tap cycles directly to the next installed SIM. -->
            <LinearLayout
                android:id="@+id/simChip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/chip_height"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_sim_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/simChipBadge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/simChipIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sim"
                    android:visibility="gone"
                    app:tint="@color/textSecondary" />

                <TextView
                    android:id="@+id/simChipName"
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:maxWidth="120dp"
                    android:textColor="@color/textPrimary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/fabKeypad"
        android:layout_width="@dimen/circle_action"
        android:layout_height="@dimen/circle_action"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="@dimen/nav_content_clearance"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/green"
        android:contentDescription="@string/show_keypad"
        android:elevation="8dp"
        android:foreground="@drawable/fg_circle_on_color"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_dialpad"
        android:visibility="gone"
        app:tint="#FFFFFF" />
</FrameLayout>
