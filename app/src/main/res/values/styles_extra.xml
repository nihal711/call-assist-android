<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Type scale (sp). Every TextView in the app maps to one of these roles:
        Caption 11 · Secondary 13 · Body 15 · Title 17 · Heading 20 · CardTitle 22
        PageTitle 26 · Display 32 · Number 40 · Hero 46
    -->
    <style name="Text.Caption" parent="android:Widget.TextView">
        <item name="android:textSize">11sp</item>
    </style>
    <style name="Text.Secondary" parent="android:Widget.TextView">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/textSecondary</item>
    </style>
    <style name="Text.Body" parent="android:Widget.TextView">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>
    <style name="Text.Title" parent="android:Widget.TextView">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>
    <style name="Text.Heading" parent="android:Widget.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>
    <style name="Text.CardTitle" parent="android:Widget.TextView">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>
    <style name="Text.PageTitle" parent="android:Widget.TextView">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <!-- Section sub-header: sentence case, accent, sits 24dp in from the gutter -->
    <style name="SectionTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accentText</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- Header action button: 48dp target, 24dp glyph -->
    <style name="HeaderAction">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/textSecondary</item>
    </style>

    <!-- Pill button: capsule, no caps -->
    <style name="AppButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/card2</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accentSoft</item>
    </style>

    <!-- Transparent window: the glass panel is the layout's own background. -->
    <style name="GlassDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowAnimationStyle">@style/GlassDialogAnim</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="GlassDialogAnim" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_out</item>
    </style>

    <!-- Outlined filter pill: hairline stroke, soft accent fill when checked.
         Visual height 40dp; Material pads the hit area out to 48dp. -->
    <style name="AppChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">15sp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStartPadding">16dp</item>
        <item name="chipEndPadding">16dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="rippleColor">@color/accentSoft</item>
    </style>

    <style name="AppSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppSheetPanel</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

    <style name="AppSheetPanel" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="shapeAppearance">@null</item>
    </style>

    <!-- Overflow menu: rounded surface matching the cards -->
    <style name="AppPopup" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>
    <style name="AppPopupOverlay" parent="ThemeOverlay.Material3">
        <item name="popupMenuStyle">@style/AppPopup</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
    </style>
</resources>
