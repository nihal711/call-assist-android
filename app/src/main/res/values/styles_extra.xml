<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CircleButton">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Pill button: dark gray, white text, no caps -->
    <style name="AppButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/card2</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accentSoft</item>
    </style>

    <!-- Transparent window: the glass panel is the layout's own background, so
         the platform must not draw its own square opaque frame behind it. -->
    <style name="GlassDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowAnimationStyle">@style/GlassDialogAnim</item>
    </style>

    <style name="GlassDialogAnim" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_out</item>
    </style>

    <!-- Rounded/glass treatment for the plain AlertDialogs elsewhere in the app
         (SIM chooser, settings pickers, block confirmations). -->
    <style name="GlassAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/GlassAlertDialogStyle</item>
        <item name="materialAlertDialogTitleTextStyle">@style/GlassAlertTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/GlassAlertButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/GlassAlertButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/GlassAlertButton</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>

    <style name="GlassAlertDialogStyle" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearanceOverlay">@style/GlassAlertShape</item>
        <item name="backgroundTint">@color/navBg</item>
    </style>

    <style name="GlassAlertShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">30dp</item>
    </style>

    <style name="GlassAlertTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GlassAlertButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>
