<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CircleButton">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Pill button: dark gray, white text, no caps -->
    <style name="AppButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/card2</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accentSoft</item>
    </style>
</resources>
